	image.ImageColor3 = Color3.fromRGB(166, 166, 166)
	image.AnchorPoint = Vector2.new(0.5, 0.5)
	image.Image = "rbxassetid://10709790644"
	image.Size = UDim2.new(0.83679, 0, 0.8336, 0)
	image.BorderColor3 = Color3.fromRGB(0, 0, 0)
