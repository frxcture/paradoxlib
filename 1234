function paradoxlibrary.slider(p)
	local spec = {
		name = p.name,
		starting = p.starting,
		max = p.max,
		min = p.min,
		parent = p.parent,
		callback = p.callback
	}

	local frame, title = elementShell(layoutholderOf(spec.parent), spec.name)

	local slider = Instance.new("Frame", frame)

	slider.BorderSizePixel = 0
	slider.BackgroundColor3 = Color3.fromRGB(11, 11, 11)
	slider.Size = UDim2.new(0.94453, 0, 0.18973, 0)
	slider.Position = UDim2.new(0.023, 0, 0.60713, 0)
	slider.BorderColor3 = Color3.fromRGB(0, 0, 0)
	slider.Name = "slider"
	slider.BackgroundTransparency = 1

	Instance.new("UICorner", slider).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame", slider)

	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Color3.fromRGB(66, 66, 66)
	fill.Size = UDim2.new(0, 0, 0.9, 0)
	fill.BorderColor3 = Color3.fromRGB(0, 0, 0)
	fill.Name = "fill"
	fill.BackgroundTransparency = 1

	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local output = Instance.new("NumberValue", slider)

	output.Name = "output"

	local trigger = invisibleButton(slider)

	local value = Instance.new("TextLabel", slider)

	value.TextWrapped = true
	value.BorderSizePixel = 0
	value.TextSize = 14
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.TextTransparency = 1
	value.TextScaled = true
	value.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	value.TextColor3 = Color3.fromRGB(166, 166, 166)
	value.BackgroundTransparency = 1
	value.Size = UDim2.new(0.10256, 0, 1.63545, 0)
	value.BorderColor3 = Color3.fromRGB(0, 0, 0)
	value.Text = "0%"
	value.Name = "value"
	value.Position = UDim2.new(0.89688, 0, -2.23546, 0)

	Instance.new("UITextSizeConstraint", value).MaxTextSize = 14
	Instance.new("UIAspectRatioConstraint", slider).AspectRatio = 29.0916

	title.Size = UDim2.new(0.66776, 0, 0.277, 0)

	bindHover(frame)

	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
	local dragging = false
	local inputEnded

	output.Value = spec.min
	value.Text = tostring(spec.starting) .. "%"

	trigger.MouseButton1Down:Connect(function()
		if dragging then
			return
		end

		dragging = true

		local mouse = game:GetService("Players").LocalPlayer:GetMouse()

		inputEnded = game:GetService("UserInputService").InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false

				if inputEnded then
					inputEnded:Disconnect()
					inputEnded = nil
				end
			end
		end)

		while dragging do
			local scale = math.clamp(((Vector2.new(mouse.X, mouse.Y) - slider.AbsolutePosition) / slider.AbsoluteSize).X, 0, 1)
			local amount = spec.min + scale * (spec.max - spec.min)

			if amount ~= output.Value then
				TweenService:Create(fill, tweenInfo, {
					Size = UDim2.fromScale(scale, 1)
				}):Play()
			end

			output.Value = amount
			value.Text = tostring(math.round(output.Value * 100)) .. "%"

			if spec.callback then
				spec.callback(tostring(math.round(output.Value * 100)))
			end

			task.wait()
		end
	end)

	return spec
end

