	page.Active = true
	page.Interactable = false
	page.BorderSizePixel = 0
	page.CanvasSize = UDim2.new(0, 0, 8, 0)
	page.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	page.Name = spec.name
	page.Size = UDim2.new(0.94366, 0, 0.63325, 0)
	page.ScrollBarImageColor3 = Color3.fromRGB(91, 91, 91)
	page.Position = UDim2.new(0.02817, 0, 0.1504, 0)
	page.BorderColor3 = Color3.fromRGB(0, 0, 0)
	page.ScrollBarThickness = 2
	page.BackgroundTransparency = 1

	local layoutholder = Instance.new("Frame", page)

	layoutholder.BorderSizePixel = 0
	layoutholder.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	layoutholder.Size = UDim2.new(0.944, 0, 0.633, 0)
	layoutholder.Position = UDim2.new(0.03881, 0, 0, 0)
	layoutholder.BorderColor3 = Color3.fromRGB(0, 0, 0)
	layoutholder.Name = "layoutholder"
	layoutholder.BackgroundTransparency = 1

	local list = Instance.new("UIListLayout", layoutholder)

	list.Padding = UDim.new(0, 5)
	list.SortOrder = Enum.SortOrder.LayoutOrder

	Instance.new("UIAspectRatioConstraint", layoutholder).AspectRatio = 0.16477
	Instance.new("UIAspectRatioConstraint", page).AspectRatio = 1.39583

	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

	trigger.MouseButton1Down:Connect(function()
		for _, child in ipairs(root.tabholder.layoutholder:GetChildren()) do
			if child:IsA("Frame") then
				local active = child.Name == spec.name

				TweenService:Create(child, tweenInfo, {
					BackgroundTransparency = active and 0.1 or 0.6
				}):Play()

				local childImage = child:FindFirstChild("image")

				if childImage then
					TweenService:Create(childImage, tweenInfo, {
						ImageColor3 = active and Color3.fromRGB(165, 165, 165) or Color3.fromRGB(90, 90, 90)
					}):Play()
				end

				local childPage = root.tabs:FindFirstChild(child.Name)

				if childPage and childPage:IsA("ScrollingFrame") then
					childPage.Interactable = active
					childPage.ScrollBarThickness = active and 2 or 0

					local holder = childPage:FindFirstChild("layoutholder")

					if holder then
						revealElements(holder, active, tweenInfo)
					end
				end
			end
		end

		if root.tabnameholder.tabname.Text ~= spec.name then
			root.tabnameholder.tabname.TextTransparency = 1
			root.tabnameholder.tabname.Text = spec.name

			TweenService:Create(root.tabnameholder.tabname, tweenInfo, {
				TextTransparency = 0
			}):Play()
		end
	end)

	return spec
end

local function bindHover(frame)
	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

	frame.MouseEnter:Connect(function()
		TweenService:Create(frame, tweenInfo, {
			BackgroundTransparency = 0
		}):Play()
	end)

	frame.MouseLeave:Connect(function()
		TweenService:Create(frame, tweenInfo, {
			BackgroundTransparency = 0.4
		}):Play()
	end)
end

