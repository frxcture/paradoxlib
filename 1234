function paradoxlibrary.button(p)
	local spec = {
		name = p.name,
		description = p.description,
		parent = p.parent,
		callback = p.callback
	}

	local frame, title = elementShell(layoutholderOf(spec.parent), spec.name)

	elementDescription(frame, spec.description)

	local image = Instance.new("ImageLabel", frame)

	image.BorderSizePixel = 0
	image.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	image.ImageTransparency = 1
	image.ImageColor3 = Color3.fromRGB(166, 166, 166)
	image.Image = "rbxassetid://10734898194"
	image.Size = UDim2.new(0.0974, 0, 0.56919, 0)
	image.BorderColor3 = Color3.fromRGB(0, 0, 0)
	image.BackgroundTransparency = 1
	image.Name = "image"
	image.Position = UDim2.new(0.87013, 0, 0.2087, 0)

	Instance.new("UIAspectRatioConstraint", image)

	local trigger = invisibleButton(frame)
	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

	bindHover(frame)

	trigger.MouseButton1Down:Connect(function()
		TweenService:Create(frame, tweenInfo, {
			BackgroundTransparency = 0
		}):Play()

		TweenService:Create(title, tweenInfo, {
			TextColor3 = Color3.fromRGB(255, 255, 255)
		}):Play()

		TweenService:Create(image, tweenInfo, {
			ImageColor3 = Color3.fromRGB(255, 255, 255)
		}):Play()

		task.wait(0.1)

		TweenService:Create(frame, tweenInfo, {
			BackgroundTransparency = 0.4
		}):Play()

		TweenService:Create(title, tweenInfo, {
			TextColor3 = Color3.fromRGB(165, 165, 165)
		}):Play()

		TweenService:Create(image, tweenInfo, {
			ImageColor3 = Color3.fromRGB(165, 165, 165)
		}):Play()

		if spec.callback then
			spec.callback()
		end
	end)

	return spec
end

