paradoxlibrary = {}

local TweenService = game:GetService("TweenService")

local function layoutholderOf(parent)
	local main = game.CoreGui and game.CoreGui.paradox and game.CoreGui.paradox.main
	local tabs = main and main:FindFirstChild("tabs")
	local tab = tabs and tabs:FindFirstChild(parent)

	if not tab then
		error("paradoxlibrary: no tab named '" .. tostring(parent) .. "'", 2)
	end

	local holder = tab:FindFirstChild("layoutholder")

	if not holder then
		error("paradoxlibrary: tab '" .. tostring(parent) .. "' has no layoutholder", 2)
	end

	return holder
end

-- elements start fully transparent, these get revealed when their tab is selected
local function revealGui(instance, transparency, info)
	if instance:IsA("TextLabel") or instance:IsA("TextBox") then
		TweenService:Create(instance, info, {
			TextTransparency = transparency
		}):Play()
	elseif instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		local parent = instance.Parent
		local toggled = parent and parent:FindFirstChild("toggled")

		if toggled then
			transparency = toggled.Value and 0 or 1
		end

		TweenService:Create(instance, info, {
			ImageTransparency = transparency
		}):Play()
	elseif instance:IsA("Frame") then
		TweenService:Create(instance, info, {
			BackgroundTransparency = transparency
		}):Play()
	end
end

local function revealElements(holder, visible, info)
	for _, element in ipairs(holder:GetChildren()) do
		if element:IsA("Frame") then
			TweenService:Create(element, info, {
				BackgroundTransparency = visible and 0.4 or 1
			}):Play()

			for _, descendant in ipairs(element:GetDescendants()) do
				revealGui(descendant, visible and 0 or 1, info)
			end
		end
	end
end

