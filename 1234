	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)
	Instance.new("UIAspectRatioConstraint", box).AspectRatio = 2.53003

	bindHover(frame)

	box.FocusLost:Connect(function()
		if spec.callback then
			spec.callback(box.Text)
		end
	end)

	return spec
end

