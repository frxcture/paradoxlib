	Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 5)

	local trigger = invisibleButton(toggle)
	local toggled = Instance.new("BoolValue", toggle)

	toggled.Name = "toggled"

	Instance.new("UIAspectRatioConstraint", toggle)
	Instance.new("UIAspectRatioConstraint", frame).AspectRatio = 2.18606

	local state = false
